<Window x:Class="EC14.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EC14 Charts" Height="720" Width="1200">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="RUN" Width="80" Height="36" Click="Run_Click"/>
      <Button Content="STOP" Width="80" Height="36" Click="Stop_Click"/>
      <Button Content="Balance" Width="100" Height="36" Click="Balance_Click"/>
      <Button Content="Offsets" Width="100" Height="36" Click="Offsets_Click"/>
      <ComboBox x:Name="DisplayMode" Width="140">
        <ComboBoxItem Content="2XY-1SC"/>
        <ComboBoxItem Content="1XY"/>
      </ComboBox>
      <ComboBox x:Name="RecordMode" Width="160">
        <ComboBoxItem Content="Off"/>
        <ComboBoxItem Content="Auto"/>
        <ComboBoxItem Content="Foot Switch"/>
      </ComboBox>
      <TextBlock Text="Status:" VerticalAlignment="Center" Margin="20,0,4,0"/>
      <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"/>
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Margin="4" Background="#101010"/>
        <Border Grid.Column="1" Margin="4" Background="#101010"/>
        <!-- placeholders for charts -->
        <TextBlock Text="Channel 1 - XY" Foreground="White" Margin="16"/>
        <TextBlock Grid.Column="1" Text="Channel 2 - XY" Foreground="White" Margin="16"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Save Data" Width="120" Height="32" Click="SaveData_Click"/>
      <Button Content="Save Image" Width="120" Height="32" Click="SaveImage_Click"/>
      <Button Content="1XY Setup" Width="120" Height="32" Click="Open1XYSetup_Click"/>
      <Button Content="2XY-1SC Setup" Width="140" Height="32" Click="Open2XY1SCSetup_Click"/>
      <Button Content="Save Settings" Width="140" Height="32" Click="SaveSettings_Click"/>
      <Button Content="Exit" Width="100" Height="32" Click="Exit_Click"/>
    </StackPanel>
  </Grid>
</Window>
